[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[core]
	editor = vim
	excludesfile = ~/.config/git/gitignore
	fsmonitor = true
	untrackedcache = true
	pager = sh -c 'command -v delta >/dev/null 2>&1 && exec delta || exec less'
[push]
	autoSetupRemote = true
[init]
	defaultBranch = master
[fetch]
	prune = true
	pruneTags = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[column]
	ui = auto
[interactive]
	diffFilter = sh -c 'command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat'
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/work/**"]
	path = ~/work/.gitconfig.local
