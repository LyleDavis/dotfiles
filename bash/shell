#!/usr/bin/env bash

if has fzf; then
    eval "$(fzf --bash)"
fi

HISTCONTROL="ignorespace:erasedups"
HISTSIZE=5000
HISTFILESIZE=5000

export EDITOR='vim'
export VISUAL='vim'
if has bat; then
    export PAGER='bat'
    export MANPAGER='bat -plman'
fi

shopt -s histappend
shopt -s cdspell
shopt -s checkwinsize
shopt -s extglob
shopt -s autocd   2>/dev/null || true
shopt -s dirspell 2>/dev/null || true
