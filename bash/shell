#!/usr/bin/env bash

if has fzf; then
    eval "$(fzf --bash)"
fi

export HISTCONTROL="ignorespace:erasedups"
export HISTSIZE=5000
export HISTFILESIZE=5000
export HISTIGNORE="ls:ll:l:pwd:clear:history"
export HISTTIMEFORMAT="%F %T "

export EDITOR='vim'
export VISUAL='vim'
if has bat; then
    export PAGER='bat'
    export MANPAGER='bat -plman'
fi

shopt -s histappend
shopt -s cdspell
shopt -s checkwinsize
shopt -s extglob
shopt -s autocd   2>/dev/null || true
shopt -s dirspell 2>/dev/null || true
shopt -s cmdhist
shopt -s lithist
shopt -s globstar
shopt -s checkjobs


set -o noclobber

