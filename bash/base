#!/usr/bin/env bash

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"

has() {
    command -v "$1" >/dev/null 2>&1
}

bootstrap_log() {
    local caller_file caller_dir module

    caller_file="${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}"
    caller_dir="$(dirname "$caller_file")"
    module="$(basename "$caller_dir")"

    [[ -n "$module" ]] || module="unknown"
    echo "[bootstrap:${module}] $*"
}

path_prepend() {
    local dir="$1"

    [[ -n "$dir" ]] || return 1
    [[ -d "$dir" ]] || return 1

    case ":$PATH:" in
        *":$dir:"*) ;;
        *) PATH="$dir:$PATH" ;;
    esac
}
